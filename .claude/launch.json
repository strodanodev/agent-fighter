{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.mjs"],
      "cwd": "packages/client",
      "env": { "PORT": "8576" },
      "port": 8576,
      "autoPort": false
    },
    {
      "name": "matchserver",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "src/server.ts"],
      "cwd": "packages/server",
      "env": { "PORT": "8477", "AF_ALLOW_DEV_ECONOMY": "1" },
      "port": 8477,
      "autoPort": false
    },
    {
      "name": "studio",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.mjs"],
      "cwd": "packages/studio",
      "env": { "PORT": "8574" },
      "port": 8574,
      "autoPort": false
    }
  ]
}
