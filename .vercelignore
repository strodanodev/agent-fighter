# Exclude large asset and tool directories
node_modules/
dist/
.bundle-tmp/
*.log

# Large binary tools
tools/ffmpeg/
tools/vgmstream/

# Large raw assets (source of truth in development, not needed for build)
characters/*/frames-raw/
assets/*.mp4
assets/*.svg

# Development and reference
.git
.claude
.cursor
.github
docs
sounds/
packages/client/shots/
