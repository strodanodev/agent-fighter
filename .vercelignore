# Build artifacts & deps (Vercel installs/builds these itself)
node_modules/
dist/
public/
.bundle-tmp/
*.log

# Binary tools — the ffmpeg .exe files exceed Vercel's 100MB per-file limit
tools/ffmpeg/
tools/vgmstream/

# Authoring scratch — raw frames are re-processed into atlases, never shipped
characters/*/frames-raw/

# Raw audio sources (converted .ogg/.mp3 ship under packages/client/assets/audio)
sounds/

# Dev-only / reference
.git
.claude
.cursor
.github
docs
packages/client/shots/
