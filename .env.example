# Agent Fighter — server-side secrets. Copy to .env (gitignored). NEVER commit
# the real values and NEVER ship any of these to the browser.

# --- Studio sprite generation -------------------------------------------------
# NVIDIA build API (flux.2-klein-4b) — used by packages/studio/server.mjs.
NVAPI_KEY=
NV_MODEL=black-forest-labs/flux.2-klein-4b
# Optional alternate providers (img2img identity lock): nvidia | bfl | fal | gemini
IMAGE_PROVIDER=nvidia
FAL_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Online (M3 Phase B / M5 credits) ----------------------------------------
# Supabase: profiles / match history / XP / credits. The SERVICE key is
# server-only — clients get no write path at all (RLS is public-read). Run
# supabase/migrations/0001_online_profiles.sql THEN 0002_credits.sql in the
# SQL editor (or `supabase db push`) before enabling online persistence.
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=
# service_role key (Dashboard → Settings → API). NOT the anon key.
SUPABASE_SERVICE_KEY=

# AIR Kit session-token verification (defaults to the public AIR JWKS;
# override only if Moca documents an environment-specific endpoint).
#AIR_JWKS_URL=https://static.air3.com/.well-known/jwks.json

# Note: the AIR *partner id* is public client config and lives in
# packages/client/src/auth.ts — it is not a secret.
